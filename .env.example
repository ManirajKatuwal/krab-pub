# Krab environment template. Copy to .env for local development.
# Full reference, including defaults and accepted values, is in
# docs/reference/environment.md — that page is the authority on behaviour.

# ── Runtime environment ───────────────────────────────────────────────────────
KRAB_ENVIRONMENT=dev            # dev | staging | prod (`local` = dev, `production` = prod).
                                # Any other value is validated like prod by the services.
KRAB_HOST=127.0.0.1
# KRAB_SERVICE_NAME and KRAB_PORT are PER-SERVICE identity, not workspace-wide
# settings. Exported globally they apply to every service that inherits them:
# one KRAB_PORT moves all of them onto the same port, and one KRAB_SERVICE_NAME
# makes every log line, metric, protocol lookup and migration record report the
# same service. Each service already defaults to its own values (frontend
# 3000/`frontend`, auth 3001/`auth`, users 3002/`users`, users-split
# 3207/`users-split`), and `krab.toml` declares them per service for
# `krab bootstrap`. Set these only for a single-service process, and only in
# that process's own environment.
# KRAB_SERVICE_NAME=            # this service's identity; defaults per crate
# KRAB_PORT=                    # this service's bind port; defaults per crate
KRAB_PUBLIC_BASE_URL=http://localhost:3000   # public origin for canonical URLs, og:url, robots sitemap link
# KRAB_SERVICE=service          # fallback service identity when KRAB_SERVICE_NAME is unset

# ── Logging ───────────────────────────────────────────────────────────────────
RUST_LOG=info                   # tracing filter (e.g. krab_core=debug,info)

# ── Authentication ────────────────────────────────────────────────────────────
KRAB_AUTH_MODE=jwt              # static | jwt | oidc
# SECURITY: You must set a unique secret token for your environment.
# Generate one with: openssl rand -hex 32
KRAB_BEARER_TOKEN=              # dev only, when KRAB_AUTH_MODE=static
KRAB_SERVICE_AUTH_SCOPE=service:internal
KRAB_AUTH_PUBLIC_PATHS=         # optional: comma-separated list of paths to allow anonymously (e.g. /public/*,/assets/*)
# KRAB_AUTH_OPEN_PATHS=         # optional: REPLACES the built-in open-path list (health,
#                               # auth endpoints, /blog/*, /pkg/*, ...). Trailing * is a
#                               # prefix match. An empty value closes every open path;
#                               # unset keeps the built-in defaults.
# KRAB_AUTH_LEGACY_OPEN_PATHS=true  # DEPRECATED (0.6.0): the default open list still holds
#                               # app routes (/, /contact, /blog/*, /rpc/*, /api/v1/auth/*...)
#                               # until 0.7.0. Declare yours in KRAB_AUTH_PUBLIC_PATHS, then
#                               # set false.
KRAB_METRICS_PUBLIC=false       # /metrics and /metrics/prometheus require auth by default.
                                # Set to true ONLY where the metrics port is reachable just
                                # by your scraper -- it publishes route names, traffic shape,
                                # error rates and latency distributions to anonymous callers.

# Authorization policy (all optional; unset means the baseline policy applies)
# KRAB_AUTH_ADMIN_ROLE=admin
# KRAB_AUTH_ADMIN_SCOPE=admin
# KRAB_AUTH_REQUIRED_ROLES=            # comma-separated
# KRAB_AUTH_REQUIRED_SCOPES=           # comma-separated
# KRAB_AUTH_REQUIRED_CLAIMS_JSON={}    # claims every token must carry
# KRAB_AUTH_ROUTE_POLICIES_JSON={}     # route pattern -> policy override
# KRAB_AUTH_REQUIRE_TENANT_CLAIM=false # reject tokens carrying no tenant claim
# KRAB_AUTH_REQUIRE_TENANT_MATCH=true # on /tenants/<id>/ paths, token tenant must equal <id>

# Sessions and CSRF. Enabling cookie sessions implies CSRF protection.
# KRAB_AUTH_COOKIE_SESSION_ENABLED=false
# KRAB_CSRF_ENABLED=false

# Token lifetimes issued by service_auth
# KRAB_AUTH_ACCESS_TTL_SECS=
# KRAB_AUTH_REFRESH_TTL_SECS=

# Bootstrap / seeded accounts (secrets — use *_FILE outside dev)
#
# Passwords are Argon2id hashes in PHC string format, NOT plaintext. Generate
# one with:  krab auth hash-password --username admin
# Outside dev/local, service_auth refuses to start on a non-PHC value, including
# one sourced from a file. In dev/local a plaintext value is accepted
# and hashed at startup.
# KRAB_AUTH_BOOTSTRAP_USER=
# KRAB_AUTH_BOOTSTRAP_PASSWORD=$argon2id$v=19$m=19456,t=2,p=1$c29tZXNhbHQ$...
# KRAB_AUTH_LOGIN_USERS_JSON={"admin":"$argon2id$v=19$m=19456,t=2,p=1$c29tZXNhbHQ$..."}

# Inter-service base URLs (overridden by KRAB_RUNTIME_ENDPOINTS_JSON when set)
# KRAB_AUTH_BASE_URL=http://127.0.0.1:3001
# KRAB_USERS_BASE_URL=http://127.0.0.1:3002
# KRAB_FRONTEND_DOWNSTREAM_BEARER_TOKEN=
# KRAB_FRONTEND_DOWNSTREAM_BEARER_TOKEN_FILE=/run/secrets/downstream_bearer_token
# KRAB_FRONTEND_DOWNSTREAM_BEARER_TOKEN_VAULT_REF=kv/data/krab/frontend#downstream_bearer_token

# Directory holding the built client bundle (service_frontend_islands.js), used to compute the
# asset manifest's real integrity digest and cache buster. The frontend links
# /pkg/service_frontend_islands.js but does not serve it, so this points at wherever
# `wasm-pack build --out-dir` put it. If the bundle cannot be read, the manifest
# publishes no integrity at all rather than an invented one.
# KRAB_FRONTEND_PKG_DIR=dist/pkg

# JWT / OIDC (required when KRAB_AUTH_MODE=jwt)
# SECURITY (staging/prod): issuer and audience validation only runs when these
# are configured, so outside dev startup REQUIRES them — either set both here
# or give every provider in KRAB_JWT_PROVIDERS_JSON its own issuer + audience.
KRAB_OIDC_ISSUER=https://issuer.example.com
KRAB_OIDC_AUDIENCE=krab-api
# SECURITY: inline KRAB_JWT_SECRET / KRAB_JWT_KEYS_JSON / KRAB_JWT_PROVIDERS_JSON is
# rejected at startup in prod (a warning in staging). Provide secret material via
# *_FILE. *_VAULT_REF is always refused today: there is no runtime vault resolver,
# so materialise the secret to a file first.
# Development only — inline values:
# KRAB_JWT_SECRET=
# KRAB_JWT_KEYS_JSON=
# KRAB_JWT_SECRET_FILE=/run/secrets/krab_jwt_secret
# KRAB_JWT_KEYS_JSON_FILE=/run/secrets/krab_jwt_keys_json
# KRAB_JWT_SECRET_VAULT_REF=kv/data/krab/auth#jwt_secret
# KRAB_JWT_KEYS_JSON_VAULT_REF=kv/data/krab/auth#jwt_keys_json
# KRAB_AUTH_BOOTSTRAP_PASSWORD_FILE=/run/secrets/krab_bootstrap_password
# KRAB_AUTH_LOGIN_USERS_JSON_FILE=/run/secrets/krab_login_users_json
# KRAB_AUTH_BOOTSTRAP_PASSWORD_VAULT_REF=kv/data/krab/auth#bootstrap_password
# KRAB_AUTH_LOGIN_USERS_JSON_VAULT_REF=kv/data/krab/auth#login_users_json
# KRAB_JWT_REQUIRE_KID=false
# Remote key set (OIDC): fetched, cached, refreshed; https:// required outside dev.
# Set KRAB_JWT_ALLOWED_ALGS to the provider's algorithm (default allowlist is HS256).
# KRAB_OIDC_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
# KRAB_OIDC_JWKS_REFRESH_SECS=300
# KRAB_OIDC_JWKS_MIN_REFETCH_SECS=30
# KRAB_OIDC_JWKS_TIMEOUT_MS=3000
# Retire a rotated-out key on a schedule (RFC 3339 or Unix seconds):
# KRAB_JWT_KEY_NOT_AFTER_JSON={"old-kid":"2026-10-01T00:00:00Z"}
# KRAB_JWT_PROVIDERS_JSON=[{"name":"default","issuer":"...","audience":"...","keys":{"default":"<base64-pem>"}}]
# KRAB_JWT_ACTIVE_KID=            # KID used to sign newly issued tokens
# KRAB_JWT_ALLOWED_ALGS=          # e.g. RS256,ES256 — unset uses the built-in allow-list.
#                                 # Never mix HS* with RS*/PS*/ES*/EdDSA: the mixed
#                                 # allowlist is rejected (algorithm-confusion guard).
# KRAB_JWT_LEEWAY_SECS=30         # clock-skew tolerance on exp/nbf

# ── Rate limiting, CORS, proxy trust ─────────────────────────────────────────
KRAB_RATE_LIMIT_CAPACITY=120         # requests per client IP per fixed window
KRAB_RATE_LIMIT_REFILL_PER_SEC=60    # window = ceil(capacity / refill) s, 1..300
KRAB_REDIS_URL=redis://127.0.0.1:6379
# KRAB_REDIS_URL_FILE=            # secret: prod rejects the inline form; an unreadable
#                                 # file fails startup outside dev
# KRAB_RATE_LIMIT_FAIL_OPEN=      # default: true in dev, false elsewhere
# KRAB_AUTH_FAILURE_WINDOW_SECS=60 # fixed window (seconds) for auth-failure rate limiting.
#                                  # Windows are tumbling, not sliding: the counter is
#                                  # keyed on floor(unix_secs / window) and resets at the
#                                  # boundary, so the worst case a client can spend is
#                                  # 2x the threshold across two adjacent windows.
#                                  # 0 or unparseable falls back to 60.
# KRAB_AUTH_FAILURE_THRESHOLD=100  # max auth failures allowed in window before 429
#                                  # 0 is valid: 429 on the first failure in the window
# KRAB_CORS_ORIGINS=              # comma-separated; unset allows no cross-origin
# SECURITY: only enable when behind a proxy you control.
# KRAB_TRUST_PROXY_HEADERS=false
# Trusted proxy hops to skip from the right of X-Forwarded-For (1 = rightmost).
# Only meaningful with KRAB_TRUST_PROXY_HEADERS=true.
# KRAB_TRUSTED_PROXY_HOPS=1
# Per-request timeout (overruns return 408); 0 disables.
# KRAB_HTTP_REQUEST_TIMEOUT_SECS=30
# Max concurrently processed requests; excess queue (backpressure). 0 disables.
# KRAB_HTTP_MAX_CONCURRENCY=1024
# HTTP concurrency overload handling mode: queue (default) or shed (fast-fail with 503).
# Anything else falls back to queue and logs env_value_invalid_using_default.
# KRAB_HTTP_OVERLOAD_MODE=queue
# Max entries in an in-process MemoryStore before eviction (0 = unlimited).
# KRAB_MEMORY_STORE_MAX_ENTRIES=100000

# ── Database ──────────────────────────────────────────────────────────────────
KRAB_DB_DRIVER=postgres         # postgres | sqlite
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=krab
POSTGRES_DB_USERS=krab_users
DATABASE_URL=
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=1
DB_ACQUIRE_TIMEOUT_SECS=5
DB_MAX_LIFETIME_SECS=1800
DB_IDLE_TIMEOUT_SECS=600
DB_CONNECT_RETRIES=5
DB_CONNECT_RETRY_DELAY_MS=750

# ── Migration governance ──────────────────────────────────────────────────────
DB_MIGRATION_ALLOW_APPLY=true
DB_MIGRATION_FAILURE_POLICY=halt          # halt | continue_non_critical
DB_MIGRATION_RELEASE_ENVIRONMENTS=staging,prod
DB_MIGRATION_REQUIRE_REHEARSAL_IN_RELEASE=true
# DB_MIGRATION_DRIFT_THRESHOLD=0          # tolerance passed to enforce_drift_policy (not automatic)
# DATABASE_URL_FILE=/run/secrets/database_url

# ── Non-functional / performance tests ───────────────────────────────────────
# Set to 1 to enable NFT suite (load, spike, soak tests) in CI.
KRAB_NFT=0
# DB-backed tests (migration lifecycle/drift/rollback) skip LOUDLY when the
# test database is unreachable. Set to 1 in CI so an unreachable database
# fails the suite instead of skipping it.
# KRAB_REQUIRE_DB_TESTS=0

# ── Protocol flexibility ─────────────────────────────────────────────────────
# Exposure mode: single protocol surface or multi-protocol surface.
# KRAB_PROTOCOL_EXPOSURE_MODE=single
# Enabled protocol set for the service process.
# KRAB_PROTOCOL_ENABLED=rest,graphql,rpc
# Default protocol used when no protocol family route dictates selection.
# KRAB_PROTOCOL_DEFAULT=rest
# Allow x-krab-protocol runtime override header (default false).
# KRAB_PROTOCOL_ALLOW_RUNTIME_SWITCH_HEADER=false
# Topology mode for deployment.
# KRAB_PROTOCOL_TOPOLOGY=single_service
# Operation-level restriction map. Example:
# KRAB_PROTOCOL_RESTRICTED_OPS_JSON={"auth.login":["rest"],"auth.refresh":["rest"]}
# Tenant-level protocol policy overrides.
# KRAB_PROTOCOL_TENANT_OVERRIDES_JSON={}
# DEV ONLY: allow the unauthenticated x-krab-tenant-id header / ?tenant_id= query
# to select tenant protocol policy when there is no authenticated tenant claim.
# Leave off in production — tenant policy then keys solely off the JWT claim.
# KRAB_PROTOCOL_TENANT_HINT_UNTRUSTED=false
# Split-topology service routing table:
# KRAB_PROTOCOL_SPLIT_TARGETS_JSON={"users":{"rest":"http://users-rest:3002","graphql":"http://users-graphql:3002","rpc":"http://users-rpc:3002"}}
# Frontend external gateway mode switches:
# KRAB_PROTOCOL_EXTERNAL_MODE=false
# KRAB_PROTOCOL_GATEWAY_BASE_URL=http://gateway:8080
# Per-service protocol override for service_users. When unset, service_users
# defaults to multi-exposure with GraphQL as the default protocol.
# KRAB_PROTOCOL_ENABLED_USERS=graphql,rest
# service_users's single-protocol binaries (users-rest, users-graphql, users-rpc)
# set their own KRAB_SERVICE_NAME, KRAB_PORT and protocol variables from these:
# KRAB_USERS_REST_SERVICE_NAME=users-rest
# KRAB_USERS_REST_HOST=127.0.0.1
# KRAB_USERS_REST_PORT=3101
# KRAB_USERS_GRAPHQL_SERVICE_NAME=users-graphql
# KRAB_USERS_GRAPHQL_HOST=127.0.0.1
# KRAB_USERS_GRAPHQL_PORT=3102
# KRAB_USERS_RPC_SERVICE_NAME=users-rpc
# KRAB_USERS_RPC_HOST=127.0.0.1
# KRAB_USERS_RPC_PORT=3103

# ── Runtime topology ─────────────────────────────────────────────────────────
# Overrides the service-contract topology and inter-service endpoints.
# KRAB_RUNTIME_TOPOLOGY=single_service
# KRAB_RUNTIME_ENDPOINTS_JSON={"auth":{"base_url":"http://127.0.0.1:3001"},"users":{"base_url":"http://127.0.0.1:3002"}}

# Timeout for native (non-WASM) server-function RPC calls, in milliseconds.
# Read once at first call; 0 or non-numeric values fall back to the default.
# KRAB_SERVER_FN_TIMEOUT_MS=30000

# ── Frontend rendering and caching ───────────────────────────────────────────
# KRAB_HYDRATION_MODE=wasm            # wasm | minimal_js | ssr_only
# KRAB_MINIMAL_JS_AUDIT=true
# service_frontend home-page budgets, passed to /_krab/home.js (ms):
# KRAB_HYDRATION_BUDGET_HOME_STARTUP_MS=1500
# KRAB_HYDRATION_BUDGET_HOME_TTFB_MS=800
# Read but not currently enforced (KB):
# KRAB_HYDRATION_BUDGET_HOME_JS_KB=160
# KRAB_HYDRATION_BUDGET_HOME_WASM_KB=512
# KRAB_ISR_REVALIDATE_SECS=30         # minimum 1
# KRAB_SSR_STREAM_BUDGET_BYTES=2097152    # 2 MiB, minimum 1024
# KRAB_CACHE_NAMESPACE=default
# KRAB_CACHE_MAX_BODY_BYTES=10485760      # 10 MiB, minimum 1024
# KRAB_DISTRIBUTED_CACHE_TTL_SECS=60      # clamped to 1..3600
# Query params allowed into ISR/SWR cache keys (comma-separated). Empty = path-only.
# FRONTEND_ISR_QUERY_ALLOWLIST=
# Max WebSocket rooms a manager will create (0 = unlimited).
# KRAB_WS_MAX_ROOMS=0

# ── Build and tooling ────────────────────────────────────────────────────────
# KRAB_SSG_BLOG_SLUGS=            # extra slugs pre-rendered by build.rs
# KRAB_REQUIRE_WASM_OPT=false     # true makes a missing wasm-opt a hard failure

# ── Tooling artifacts ─────────────────────────────────────────────────────────
# Root for tooling artifacts (release/rehearsal evidence, orchestrator logs).
# Defaults to .krab/ (internal/audit/ is used, with a deprecation warning,
# while that directory exists; removed in 0.7.0).
# KRAB_ARTIFACT_DIR=.krab
