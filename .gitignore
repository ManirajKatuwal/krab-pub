# Build artifacts
/target/
/dist/pkg/
dist/.hmr_signal

# `wasm-pack build` output for the reference application. Generated by the
# `reference-app` CI gate and by anyone following its README.
/examples/reference_apps/islands_rpc/pkg/

# `wasm-pack build` output for the frontend service (see
# services/service_frontend/public/README.md) and the SSG stubs written by its
# build.rs.
/services/service_frontend/public/pkg/
/services/service_frontend/public/__ssg/

# Local environment (never commit secrets)
.env*
!.env.example

# SQLite dev databases
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Python tooling
__pycache__/
*.py[cod]

# Node tooling
node_modules/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Editor/merge droppings and runtime logs
*.log
*.tmp
*.orig
*.rej
*.bak
frontend_stdout.txt
frontend_stderr.txt

# OS
.DS_Store
Thumbs.db

# Agent tooling (maintainer-local: worktrees, skills, local settings)
.claude/

# ---------------------------------------------------------------------------
# Internal documentation and evidence (not for public distribution).
# Everything internal lives under internal/ so this stays a single rule.
#   internal/plans/    planning documents and roadmaps
#   internal/audit/    audit reports, evidence bundles, generated CI evidence
#   internal/wiki/     engineering wiki
#   internal/reports/  strategy, framework, and pre-release reports
# ---------------------------------------------------------------------------
internal/

# Generated benchmark/NFT results (inputs in benchmarks/ stay tracked)
benchmarks/latest_summary*.md
benchmarks/release_evidence_bundle.*
benchmarks/*_replica_results.json
benchmarks/shared_state_*.json

# Rendered compose output
docker/composed.nft.rendered.yaml
