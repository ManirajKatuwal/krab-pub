Thumbs.db

# ---------------------------------------------------------------------------
# Internal documentation and evidence (not for public distribution).
# Everything internal lives under internal/ so this stays a single rule.
#   internal/plans/    planning documents and roadmaps
#   internal/audit/    audit reports, evidence bundles, generated CI evidence
#   internal/wiki/     engineering wiki
#   internal/reports/  strategy, framework, and pre-release reports
# ---------------------------------------------------------------------------
internal/

# Generated benchmark/NFT results (inputs in benchmarks/ stay tracked)
benchmarks/latest_summary*.md
benchmarks/release_evidence_bundle.*
benchmarks/*_replica_results.json
benchmarks/shared_state_validation.json

# Rendered compose output
docker/composed.nft.rendered.yaml
