# Krab environment template. Copy to .env for local development.
# Full reference, including defaults and accepted values, is in
# docs/reference/environment.md — that page is the authority on behaviour.

# ── Runtime environment ───────────────────────────────────────────────────────
KRAB_ENVIRONMENT=local          # dev | staging | prod | local
KRAB_SERVICE_NAME=krab          # overrides the crate-default service name
KRAB_HOST=127.0.0.1
KRAB_PORT=3000
KRAB_PUBLIC_BASE_URL=http://localhost:3000   # public origin for canonical URLs, og:url, robots sitemap link
# KRAB_SERVICE=service          # fallback service identity when KRAB_SERVICE_NAME is unset

# ── Logging ───────────────────────────────────────────────────────────────────
RUST_LOG=info                   # tracing filter (e.g. krab_core=debug,info)

# ── Authentication ────────────────────────────────────────────────────────────
KRAB_AUTH_MODE=jwt              # static | jwt | oidc
# SECURITY: You must set a unique secret token for your environment.
# Generate one with: openssl rand -hex 32
KRAB_BEARER_TOKEN=              # local/dev only when KRAB_AUTH_MODE=static
KRAB_SERVICE_AUTH_SCOPE=service:internal
KRAB_AUTH_PUBLIC_PATHS=         # optional: comma-separated list of paths to allow anonymously (e.g. /public/*,/assets/*)

# Authorization policy (all optional; unset means the baseline policy applies)
# KRAB_AUTH_ADMIN_ROLE=admin
# KRAB_AUTH_ADMIN_SCOPE=admin
# KRAB_AUTH_REQUIRED_ROLES=            # comma-separated
# KRAB_AUTH_REQUIRED_SCOPES=           # comma-separated
# KRAB_AUTH_REQUIRED_CLAIMS_JSON={}    # claims every token must carry
# KRAB_AUTH_ROUTE_POLICIES_JSON={}     # route pattern -> policy override
# KRAB_AUTH_REQUIRE_TENANT_CLAIM=false # reject tokens carrying no tenant claim
# KRAB_AUTH_REQUIRE_TENANT_MATCH=false

# Sessions and CSRF. Enabling cookie sessions implies CSRF protection.
# KRAB_AUTH_COOKIE_SESSION_ENABLED=false
# KRAB_CSRF_ENABLED=false

# Token lifetimes issued by service_auth
# KRAB_AUTH_ACCESS_TTL_SECS=
# KRAB_AUTH_REFRESH_TTL_SECS=

# Bootstrap / seeded accounts (secrets — use *_FILE or *_VAULT_REF outside local)
# KRAB_AUTH_BOOTSTRAP_USER=
# KRAB_AUTH_BOOTSTRAP_PASSWORD=
# KRAB_AUTH_LOGIN_USERS_JSON=

# Inter-service base URLs (overridden by KRAB_RUNTIME_ENDPOINTS_JSON when set)
# KRAB_AUTH_BASE_URL=http://127.0.0.1:3001
# KRAB_USERS_BASE_URL=http://127.0.0.1:3002

# JWT / OIDC (required when KRAB_AUTH_MODE=jwt)
KRAB_OIDC_ISSUER=https://issuer.example.com
KRAB_OIDC_AUDIENCE=krab-api
# SECURITY (staging/prod): inline KRAB_JWT_SECRET / KRAB_JWT_KEYS_JSON is forbidden.
# Provide secret material via *_FILE or your vault reference envs.
# Local development only — startup rejects these outside KRAB_ENVIRONMENT=local:
# KRAB_JWT_SECRET=
# KRAB_JWT_KEYS_JSON=
# KRAB_JWT_SECRET_FILE=/run/secrets/krab_jwt_secret
# KRAB_JWT_KEYS_JSON_FILE=/run/secrets/krab_jwt_keys_json
# KRAB_JWT_SECRET_VAULT_REF=kv/data/krab/auth#jwt_secret
# KRAB_JWT_KEYS_JSON_VAULT_REF=kv/data/krab/auth#jwt_keys_json
# KRAB_AUTH_BOOTSTRAP_PASSWORD_FILE=/run/secrets/krab_bootstrap_password
# KRAB_AUTH_LOGIN_USERS_JSON_FILE=/run/secrets/krab_login_users_json
# KRAB_AUTH_BOOTSTRAP_PASSWORD_VAULT_REF=kv/data/krab/auth#bootstrap_password
# KRAB_AUTH_LOGIN_USERS_JSON_VAULT_REF=kv/data/krab/auth#login_users_json
# KRAB_JWT_REQUIRE_KID=false
# KRAB_JWT_PROVIDERS_JSON=[{"name":"default","issuer":"...","audience":"...","keys":{"default":"<base64-pem>"}}]
# KRAB_JWT_ACTIVE_KID=            # KID used to sign newly issued tokens
# KRAB_JWT_ALLOWED_ALGS=          # e.g. RS256,ES256 — unset uses the built-in allow-list
# KRAB_JWT_LEEWAY_SECS=           # clock-skew tolerance on exp/nbf

# ── Rate limiting, CORS, proxy trust ─────────────────────────────────────────
KRAB_RATE_LIMIT_CAPACITY=120
KRAB_RATE_LIMIT_REFILL_PER_SEC=60
KRAB_REDIS_URL=redis://127.0.0.1:6379
# KRAB_RATE_LIMIT_FAIL_OPEN=      # default: true in dev, false elsewhere
# KRAB_CORS_ORIGINS=              # comma-separated; unset allows no cross-origin
# SECURITY: only enable when behind a proxy you control.
# KRAB_TRUST_PROXY_HEADERS=false

# ── Database ──────────────────────────────────────────────────────────────────
KRAB_DB_DRIVER=postgres         # postgres | sqlite
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=krab
POSTGRES_DB_USERS=krab_users
DATABASE_URL=
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=1
DB_ACQUIRE_TIMEOUT_SECS=5
DB_MAX_LIFETIME_SECS=1800
DB_IDLE_TIMEOUT_SECS=600
DB_CONNECT_RETRIES=5
DB_CONNECT_RETRY_DELAY_MS=750

# ── Migration governance ──────────────────────────────────────────────────────
DB_MIGRATION_ALLOW_APPLY=true
DB_MIGRATION_FAILURE_POLICY=halt          # halt | continue_non_critical
DB_MIGRATION_RELEASE_ENVIRONMENTS=staging,prod
DB_MIGRATION_REQUIRE_REHEARSAL_IN_RELEASE=true
# DB_MIGRATION_DRIFT_THRESHOLD=0          # 0 = any drift blocks startup
# DATABASE_URL_FILE=/run/secrets/database_url

# ── Non-functional / performance tests ───────────────────────────────────────
# Set to 1 to enable NFT suite (load, spike, soak tests) in CI.
KRAB_NFT=0

# ── Protocol flexibility ─────────────────────────────────────────────────────
# Exposure mode: single protocol surface or multi-protocol surface.
# KRAB_PROTOCOL_EXPOSURE_MODE=single
# Enabled protocol set for the service process.
# KRAB_PROTOCOL_ENABLED=rest,graphql,rpc
# Default protocol used when no protocol family route dictates selection.
# KRAB_PROTOCOL_DEFAULT=rest
# Allow x-krab-protocol runtime override header (default false).
# KRAB_PROTOCOL_ALLOW_RUNTIME_SWITCH_HEADER=false
# Topology mode for deployment.
# KRAB_PROTOCOL_TOPOLOGY=single_service
# Operation-level restriction map. Example:
# KRAB_PROTOCOL_RESTRICTED_OPS_JSON={"auth.login":["rest"],"auth.refresh":["rest"]}
# Tenant-level protocol policy overrides.
# KRAB_PROTOCOL_TENANT_OVERRIDES_JSON={}
# Split-topology service routing table:
# KRAB_PROTOCOL_SPLIT_TARGETS_JSON={"users":{"rest":"http://users-rest:3002","graphql":"http://users-graphql:3002","rpc":"http://users-rpc:3002"}}
# Frontend external gateway mode switches:
# KRAB_PROTOCOL_EXTERNAL_MODE=false
# KRAB_PROTOCOL_GATEWAY_BASE_URL=http://gateway:8080
# Per-service protocol override for service_users. When unset, service_users
# defaults to multi-exposure with GraphQL as the default protocol.
# KRAB_PROTOCOL_ENABLED_USERS=graphql,rest

# ── Runtime topology ─────────────────────────────────────────────────────────
# Overrides the service-contract topology and inter-service endpoints.
# KRAB_RUNTIME_TOPOLOGY=single_service
# KRAB_RUNTIME_ENDPOINTS_JSON={"auth":{"base_url":"http://127.0.0.1:3001"},"users":{"base_url":"http://127.0.0.1:3002"}}

# ── Frontend rendering and caching ───────────────────────────────────────────
# KRAB_HYDRATION_MODE=wasm            # wasm | minimal_js | ssr_only
# KRAB_MINIMAL_JS_AUDIT=true
# KRAB_ISR_REVALIDATE_SECS=30         # minimum 1
# KRAB_SSR_STREAM_BUDGET_BYTES=2097152    # 2 MiB, minimum 1024
# KRAB_CACHE_NAMESPACE=default
# KRAB_CACHE_MAX_BODY_BYTES=10485760      # 10 MiB, minimum 1024
# KRAB_DISTRIBUTED_CACHE_TTL_SECS=60      # clamped to 1..3600

# ── Build and tooling ────────────────────────────────────────────────────────
# KRAB_SSG_BLOG_SLUGS=            # extra slugs pre-rendered by build.rs
# KRAB_REQUIRE_WASM_OPT=false     # true makes a missing wasm-opt a hard failure
